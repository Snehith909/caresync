DATABASE_URL=sqlite:///./caresync.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760
REMINDER_GRACE_MINUTES=15
NOMINEE_ESCALATION_MINUTES=30
HOSPITAL_MISSED_DAYS_THRESHOLD=3
# Keep this value on the backend only. Never put the API secret in Flutter.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_UPLOAD_BYTES=26214400
GEMINI_API_KEY=replace_with_rotated_key
GEMINI_MODEL=gemini-2.0-flash